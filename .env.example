# ============================================================================
# TripMap - Variáveis de Ambiente
# Copie para .env se desejar customizar portas, senhas ou a pasta de importação
# ============================================================================

# PostgreSQL (PostGIS + pgvector)
POSTGRES_USER=tripmap
POSTGRES_PASSWORD=tripmap_secret
POSTGRES_DB=tripmap
DATABASE_URL=postgresql+psycopg://tripmap:tripmap_secret@postgres:5432/tripmap

# S3 Object Storage (RustFS)
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin_secret
S3_REGION=us-east-1

# Pasta local no seu computador contendo fotos/vídeos (iPhone 16 Plus, Galaxy S25, etc.)
# Será montada dentro do backend em /import
LOCAL_IMPORT_HOST_PATH=./import_media
IMPORT_DIR=/import

# Configurações de Agrupamento de Viagens (Momentos)
TRIP_MAX_HOURS_GAP=36
TRIP_MAX_DISTANCE_KM=85

# Limiar de similaridade facial (Cosseno: 0.42 a 0.55)
FACE_SIMILARITY_THRESHOLD=0.48

# Portas expostas no Host (ajustadas para não conflitar com AdGuard 3000, lore 3001/8001/5432, Portainer 8000/9000)
FRONTEND_PORT=3002
BACKEND_PORT=8002
POSTGRES_PORT=5433
RUSTFS_API_PORT=9002
RUSTFS_CONSOLE_PORT=9003
